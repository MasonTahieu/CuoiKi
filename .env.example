# VN30-HNX30 screener: SSI is the selected provider after instructor approval.
DATA_PROVIDER=ssi
APP_MODE=demo
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Select ONLY after SSI confirms the service/version you registered.
# unselected | fcdata_v2 | fastconnect_v3   (SSI hiện cấp FastConnect API V3 qua developers.ssi.com.vn)
SSI_API_PROFILE=unselected
# FCData v2 (cũ)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
# FastConnect V3: API Key/Secret tạo trên Developer Portal sau khi SSI kích hoạt dịch vụ.
SSI_API_KEY=
SSI_API_SECRET=
# Client ID chỉ điền nếu SSI cấp kèm; để trống nếu không có.
SSI_CLIENT_ID=
# OTP khi đăng nhập V3: prompt (SMS/email, nhập trên cửa sổ lệnh) | smart (duyệt trên app) | none (chỉ REST dữ liệu).
# Theo tài liệu SDK, mở stream cần token đăng nhập có OTP. OTP không bao giờ ghi vào tệp.
SSI_OTP_MODE=prompt
# index: đăng ký theo rổ trade.VN30@* (ít topic) | symbols: từng mã (dự phòng nếu rổ bị từ chối)
SSI_V3_SUBSCRIBE=index
# Optional public addresses; blank uses the documented defaults of the selected profile.
# FCData v2 REST: https://fc-data.ssi.com.vn/api/v2/Market/
# V3 REST: https://api.ssi.com.vn ; V3 WebSocket: wss://stream.ssi.com.vn/ws/v3
# Other hosts are refused before any key is sent.
SSI_REST_BASE=
SSI_STREAM_BASE=
SSI_DATABASE=runtime/ssi.sqlite
SSI_SEMANTICS_VERIFIED=false

# Legacy NEO configuration. Not used when DATA_PROVIDER=ssi.
NEO_ACCESS_TOKEN=
NEO_DEVICE_ID=
NEO_DEVICE_TYPE=chrome
NEO_WS_URL=
NEO_WS_FORMAT=bare
NEO_UPDATE_MODE=snapshot
NEO_SEMANTICS_VERIFIED=false
NEO_DATABASE=runtime/neo.sqlite
